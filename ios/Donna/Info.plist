<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Donna</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
	  <!-- Do not change NSAllowsArbitraryLoads to true, or you will risk app rejection! -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string></string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Donna needs the microphone to hear you during a conversation.</string>
	<!-- Bluetooth isn't used for conversation mode yet, but ambient mode
	     (Phase 3) will gate listening on a connected Bluetooth device, so
	     the usage description is added now — see NOTES.md. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Donna checks for a connected Bluetooth device before listening in the background.</string>
	<!-- Phase 3: ambient mode. The "audio" background mode is what lets
	     AVAudioSession (configured for .playAndRecord in
	     AmbientAudioModule.swift) keep receiving microphone input once
	     the app is backgrounded or the screen is locked — the same
	     mechanism VoIP/podcast/dictation apps use for background audio.
	     Read NOTES.md "Phase 3 — iOS" before assuming this means
	     unconditional always-on background listening: iOS can still
	     suspend the app if it decides the audio session isn't genuinely
	     active, and Apple's App Review guidelines (2.5.4) specifically
	     scrutinize this background mode's use for anything other than
	     continuous, user-evident audio activity. This is the most
	     capable real mechanism available without a special
	     Apple-granted entitlement (e.g. PushToTalk) — not a guarantee. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
