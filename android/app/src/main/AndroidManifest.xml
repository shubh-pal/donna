<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phase 2: conversation mode (mic capture) and permission-status
         checks surfaced in Settings. Bluetooth/notifications are checked
         defensively for later phases (ambient mode) — see NOTES.md. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Android 12+ (API 31+); ignored/unavailable on older versions. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 13+ (API 33+); ignored/unavailable on older versions. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Phase 3: ambient mode's Android foreground service. Both
         permissions are required for a foreground service that captures
         the microphone to keep running once the app is backgrounded or
         the screen is locked — FOREGROUND_SERVICE is the general
         permission every foreground service needs (all API levels);
         FOREGROUND_SERVICE_MICROPHONE is the type-specific permission
         Android 14+ (API 34+) additionally requires for the
         "microphone" foreground service type declared below. Without
         both, the OS silently stops delivering mic audio once the app
         leaves the foreground. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The haptic half of ambient mode's listening indicator
         (useAmbientMode.ts's pulseHaptic) — a normal permission, granted
         automatically at install, no runtime prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- Phase 3: ambient mode's foreground service — see
           android/app/src/main/java/com/donna/ambient/AmbientForegroundService.kt.
           exported="false": only this app may start it.
           foregroundServiceType="microphone" is what actually lets
           AudioRecord keep capturing once the app is backgrounded on
           Android 10+ (and is mandatory metadata on Android 14+ for any
           service that calls startForeground() with the microphone
           type). -->
      <service
        android:name=".ambient.AmbientForegroundService"
        android:exported="false"
        android:foregroundServiceType="microphone" />
    </application>
</manifest>
